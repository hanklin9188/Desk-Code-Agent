{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded Subtask Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "task_id",
    "contract_revision",
    "subtasks",
    "critical_path",
    "budgets"
  ],
  "properties": {
    "plan_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "contract_revision": {
      "type": "integer",
      "minimum": 1
    },
    "subtasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "goal",
          "depends_on",
          "allowed_skills",
          "completion_criteria",
          "max_attempts"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "goal": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowed_skills": {
            "type": "array",
            "items": {
              "pattern": "^[RD][0-9]{2}$",
              "type": "string"
            }
          },
          "completion_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "max_attempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "logical_parallel_group": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "critical_path": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_llm_calls",
        "max_tool_calls",
        "max_wall_seconds"
      ],
      "properties": {
        "max_llm_calls": {
          "type": "integer",
          "minimum": 0
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "max_wall_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
