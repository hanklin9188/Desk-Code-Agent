{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Diagnosis Hypotheses",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "diagnosis_id",
    "task_id",
    "repro_id",
    "hypotheses",
    "selected_hypothesis",
    "confidence",
    "evidence_ids"
  ],
  "properties": {
    "diagnosis_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "repro_id": {
      "type": "string"
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rank",
          "statement",
          "prediction",
          "probe",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "statement": {
            "type": "string"
          },
          "prediction": {
            "type": "string"
          },
          "probe": {
            "type": "string"
          },
          "status": {
            "enum": [
              "UNTESTED",
              "SUPPORTED",
              "FALSIFIED",
              "INCONCLUSIVE"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "selected_hypothesis": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
