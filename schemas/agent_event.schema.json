{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Event",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "enum": [
        "debug",
        "info",
        "warning",
        "error",
        "critical"
      ]
    },
    "payload": {
      "type": "object"
    },
    "privacy": {
      "type": "string",
      "enum": [
        "local_only",
        "redacted_exportable",
        "public_safe"
      ]
    }
  },
  "required": [
    "event_id",
    "run_id",
    "task_id",
    "sequence",
    "timestamp",
    "source",
    "type",
    "severity",
    "payload",
    "privacy"
  ]
}
