{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approval Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_id",
    "run_id",
    "action",
    "target",
    "artifact_hash",
    "decision",
    "decided_at",
    "expires_at"
  ],
  "properties": {
    "approval_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "artifact_hash": {
      "type": "string"
    },
    "decision": {
      "enum": [
        "APPROVED",
        "DENIED",
        "EXPIRED",
        "REVOKED"
      ]
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "string"
    },
    "scope": {
      "type": "object"
    }
  }
}
