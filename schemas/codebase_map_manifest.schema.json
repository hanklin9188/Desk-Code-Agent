{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codebase Map Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "map_id",
    "baseline_sha",
    "index_version",
    "adapters",
    "counts",
    "confidence",
    "database_path"
  ],
  "properties": {
    "map_id": {
      "type": "string"
    },
    "baseline_sha": {
      "type": "string"
    },
    "index_version": {
      "type": "string"
    },
    "adapters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "files",
        "symbols",
        "edges",
        "tests"
      ],
      "properties": {
        "files": {
          "type": "integer"
        },
        "symbols": {
          "type": "integer"
        },
        "edges": {
          "type": "integer"
        },
        "tests": {
          "type": "integer"
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "database_path": {
      "type": "string"
    },
    "fallbacks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
