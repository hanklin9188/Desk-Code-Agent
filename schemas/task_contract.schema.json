{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task Contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "repo_ref": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "ANALYZE",
          "DEBUG",
          "CODE",
          "TEST",
          "REVIEW",
          "REFACTOR",
          "DOCUMENT",
          "ONBOARD",
          "MIXED"
        ]
      }
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "approval_required": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope_uncertainties": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "contract_hash": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "task_id",
    "repo_ref",
    "goal",
    "modes",
    "success_criteria",
    "constraints",
    "non_goals",
    "approval_required",
    "scope_uncertainties",
    "contract_hash"
  ]
}
