{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Run Summary",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "final_status": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "PARTIAL_SUCCESS",
        "FAILED",
        "BLOCKED",
        "CANCELLED"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "llm_calls": {
      "type": "integer",
      "minimum": 0
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "tool_calls": {
      "type": "integer",
      "minimum": 0
    },
    "files_read": {
      "type": "integer",
      "minimum": 0
    },
    "files_changed": {
      "type": "integer",
      "minimum": 0
    },
    "peak_vram_mb": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "elapsed_ms": {
      "type": "integer",
      "minimum": 0
    },
    "artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "safety_blocks": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "run_id",
    "task_id",
    "final_status",
    "started_at",
    "ended_at",
    "llm_calls",
    "input_tokens",
    "output_tokens",
    "tool_calls",
    "files_read",
    "files_changed",
    "peak_vram_mb",
    "elapsed_ms",
    "artifact_ids",
    "safety_blocks"
  ]
}
