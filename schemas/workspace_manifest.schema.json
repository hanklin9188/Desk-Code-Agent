{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workspace Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "repo_locator",
    "workspace_root",
    "baseline_sha",
    "mutation_root",
    "original_read_only",
    "network_used",
    "created_at"
  ],
  "properties": {
    "workspace_id": {
      "type": "string"
    },
    "repo_locator": {
      "type": "string"
    },
    "workspace_root": {
      "type": "string"
    },
    "baseline_sha": {
      "type": "string"
    },
    "mutation_root": {
      "type": "string"
    },
    "original_read_only": {
      "const": true
    },
    "network_used": {
      "type": "boolean"
    },
    "dirty_baseline": {
      "type": "boolean"
    },
    "rollback_ref": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
