{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External Source Lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sources"
  ],
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "url",
          "revision",
          "license",
          "purpose"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
