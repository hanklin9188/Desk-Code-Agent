{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Patch Plan",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "base_commit": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": [
              "string",
              "null"
            ]
          },
          "operation": {
            "type": "string",
            "enum": [
              "ADD",
              "MODIFY",
              "DELETE",
              "RENAME",
              "TEST_ONLY",
              "DOC_ONLY"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "path",
          "symbol",
          "operation",
          "rationale",
          "evidence_ids"
        ]
      }
    },
    "verification_stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "rollback_condition": {
      "type": "string",
      "minLength": 1
    },
    "plan_hash": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "plan_id",
    "task_id",
    "base_commit",
    "goal",
    "invariants",
    "changes",
    "verification_stages",
    "risk_level",
    "rollback_condition",
    "plan_hash"
  ]
}
