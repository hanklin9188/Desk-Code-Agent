{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill Definition Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill_id",
    "name",
    "display_name",
    "version",
    "category",
    "kind",
    "invocation",
    "owner",
    "risk",
    "status",
    "max_llm_calls",
    "max_context_tokens",
    "schema_version"
  ],
  "properties": {
    "skill_id": {
      "pattern": "^[DR][0-9]{2}$",
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "category": {
      "enum": [
        "development",
        "runtime"
      ]
    },
    "kind": {
      "enum": [
        "development-skill",
        "runtime-skill"
      ]
    },
    "invocation": {
      "enum": [
        "user",
        "model",
        "runtime"
      ]
    },
    "owner": {
      "type": "string"
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "status": {
      "enum": [
        "design",
        "experimental",
        "candidate",
        "production",
        "disabled",
        "deprecated"
      ]
    },
    "max_llm_calls": {
      "type": "integer",
      "minimum": 0
    },
    "max_context_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
